; Source-check fixture; initialized runtime search/point state is not implied.
(defconst state-goal 100)
(defconst hp-goal 110)
(defconst point-goal 120)
(defconst status-ready 2)
(defconst list-active 0)
(defconst search-remote 2)
(defconst search-order-asc 1)
(defconst object-data-hitpoints 10)
(defconst object-data-distance 44)
(defconst object-data-action 5)
(defconst object-data-target-id 23)
(defconst action-patrol 2)
(defconst action-move 1)
(defconst formation-line 2)
(defconst stance-aggressive 0)
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 10)
    (up-filter-status c: status-ready c: list-active)
    (up-find-local c: 83 c: 20)
    (up-find-remote c: 83 c: 10)
    (up-clean-search search-remote -1 search-order-asc)
    (up-get-search-state state-goal)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-hitpoints hp-goal)
    (up-get-object-data object-data-distance 111)
    (up-get-object-data object-data-action 112)
    (up-get-object-data object-data-target-id 113)
    (up-set-target-point point-goal)
    (up-target-objects 1 action-patrol formation-line stance-aggressive)
    (up-target-point 0 action-move -1 -1)
    (disable-self)
)
